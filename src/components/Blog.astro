---
// Blog Section Component
import { getRecentBlogPosts } from '../lib/blog';

const recentPosts = await getRecentBlogPosts(3);

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  }).format(date);
}
---

<section id="blog" class="mb-24 scroll-mt-16">
  <h2 class="sticky top-0 z-10 backdrop-blur-sm bg-slate-900/80 py-6 mb-6 text-sm font-semibold uppercase tracking-widest text-slate-200 lg:hidden">Blog</h2>
  
  <div class="flex flex-col gap-8">
    {recentPosts.length > 0 ? (
      recentPosts.map((post) => (
        <a 
          href={`/blog/${post.slug}`} 
          class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-4 p-6 rounded-lg transition-all duration-300 hover:bg-slate-800/50 hover:shadow-[0_0_0_1px_rgba(148,163,184,0.1)] group"
        >
          {post.imageUrl ? (
            <div class="w-full aspect-video rounded overflow-hidden border border-slate-400/20 bg-slate-900/50">
              <img 
                src={post.imageUrl} 
                alt={post.title}
                class="w-full h-full object-cover"
              />
            </div>
          ) : (
            <div class="w-full aspect-video rounded overflow-hidden border border-slate-400/20 bg-gradient-to-br from-slate-800/80 to-slate-700/80 flex items-center justify-center text-slate-600">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
          )}
          
          <div class="flex flex-col gap-3">
            <h3 class="text-base font-medium text-slate-200 m-0 group-hover:text-teal-300 transition-colors duration-200">
              {post.title}
            </h3>
            <p class="text-slate-400 text-xs uppercase tracking-wide">
              {formatDate(post.publishedAt)} · {post.author}
            </p>
            <p class="text-slate-400 leading-relaxed text-sm">
              {post.excerpt}
            </p>
            {post.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-2">
                {post.tags.map((tag) => (
                  <span class="inline-block px-3 py-1 bg-teal-400/10 text-teal-300 rounded-full text-xs font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))
    ) : (
      <p class="text-slate-400 text-center py-8">No blog posts available yet.</p>
    )}
  </div>
  
  <a 
    href="/blog" 
    class="inline-flex items-center gap-2 mt-8 text-slate-200 font-medium transition-all duration-200 hover:text-teal-300 group"
  >
    <span>View All Posts</span>
    <svg 
      class="w-4 h-4 flex-shrink-0 transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-1" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-width="2"
    >
      <line x1="7" y1="17" x2="17" y2="7"></line>
      <polyline points="7 7 17 7 17 17"></polyline>
    </svg>
  </a>
</section>
