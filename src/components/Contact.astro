---
// The close: the Notify party again, at full size, then the place and date of issue.
import CopyEmail from './lading/CopyEmail.astro';
import SectionHead from './lading/SectionHead.astro';
import { profile } from '../data/profile';
import { formatDay } from '../lib/format';

const year = profile.revised.slice(0, 4);
---

<footer id="contact" aria-labelledby="contact-heading" class="scroll-mt-14 border-t-2 border-form bg-paper-deep">
  <div class="mx-auto max-w-[85rem] px-4 pb-10 pt-16 sm:px-8 lg:pt-24">
    <SectionHead n={14} id="contact-heading" title="Notify party" note={profile.roles} />

    <div data-email-group class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a
        href={`mailto:${profile.email}`}
        data-contact-email
        class="py-2.5 text-[clamp(1.75rem,5vw,3.5rem)] font-extrabold leading-[1.05] tracking-[-0.02em] underline decoration-form decoration-[3px] underline-offset-[10px] transition-[text-decoration-thickness] duration-150 wrap-anywhere hover:decoration-[5px]"
      >
        {profile.email}
      </a>
      <CopyEmail email={profile.email} />
    </div>

    <ul class="mt-5 flex flex-wrap gap-x-7 text-base font-semibold">
      <li><a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="inline-block py-3 underline decoration-form/40 underline-offset-4 hover:decoration-form">LinkedIn</a></li>
      <li><a href={profile.github} target="_blank" rel="noopener noreferrer" class="inline-block py-3 underline decoration-form/40 underline-offset-4 hover:decoration-form">GitHub</a></li>
      <li><a href={profile.resume} type="application/pdf" target="_blank" rel="noopener" class="inline-block py-3 underline decoration-form/40 underline-offset-4 hover:decoration-form">Résumé (PDF)</a></li>
    </ul>

    <dl class="mt-14 grid grid-cols-12 gap-px border-2 border-form bg-form">
      <div class="col-span-12 bg-paper px-4 py-4 sm:col-span-4 sm:px-5">
        <dt class="text-[0.8125rem] font-semibold text-form">Place of issue</dt>
        <dd class="mt-1.5 font-extrabold">{profile.based}</dd>
      </div>
      <div class="col-span-12 bg-paper px-4 py-4 sm:col-span-4 sm:px-5">
        <dt class="text-[0.8125rem] font-semibold text-form">Date of issue</dt>
        <dd class="mt-1.5 font-extrabold">{formatDay(profile.revised)}</dd>
      </div>
      <div class="col-span-12 bg-paper px-4 py-4 sm:col-span-4 sm:px-5">
        <dt class="text-[0.8125rem] font-semibold text-form">Signed for the shipper</dt>
        <dd class="mt-1.5 font-extrabold">{profile.name}</dd>
      </div>
    </dl>

    <p class="mt-8 flex flex-wrap justify-between gap-x-6 gap-y-2 text-sm text-form">
      <span>© {year} {profile.name}</span>
      <a href="/blog" class="-my-3 inline-block py-3 underline decoration-form/40 underline-offset-4 hover:decoration-form">Blog</a>
    </p>
  </div>
</footer>
