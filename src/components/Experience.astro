---
// Experience Section
export interface Experience {
  period: string;
  role: string;
  company: string;
  companyUrl: string;
  description: string;
  technologies: string[];
  order?: number;
}

const experiences : Experience[] = [
  {
    period: "July 2023 — Present",
    role: "Microsoft Dynamics AX 2012 R3 Developer",
    company: "PT. Gandum Mas Kencana",
    companyUrl: "https://gandummas.co.id/",
    description: "Responsible for creating and maintaining AX 2012 and satellite systems custom code based on the business requirements. Developing integration solutions using ASP.NET Web API as the backend and other frontend technologies such as Flutter for mobile applications.",
    technologies: ["X++", "C#", "Dynamics AX 2012 R3", "ASP.NET Web API", "Flutter", "Dart"]
  },
  {
    period: "February 2019 — July 2023",
    role: "Microsoft Dynamics Ecosystem Developer",
    company: "PT. Intikom Berlian Mustika",
    companyUrl: "https://intikom.com/",
    description: "Responsible for developing solutions based from business requirements that depend on multiple Microsoft Dynamics Products, including PowerApps, Power Automate, Dynamics Finance and Operations, Dynamics Business Central, Azure DevOps, and Microsoft LCS.",
    technologies: ["X++", "AL Language", "C#", "PowerApps", "Power Automate", "Dynamics 365", "Azure DevOps"]
  },
  {
    period: "January 2018 — February 2019",
    role: "Microsoft Dynamics AX 2012 R3 Developer",
    company: "PT. Visionet Data Internasional",
    companyUrl: "https://www.visionet.co.id/",
    description: "Microsoft Dynamics AX 2012 R3 Developer, responsible for creating and maintaining custom code based from the business requirements.",
    technologies: ["X++", "Dynamics AX 2012 R3", "SQL Server"]
  }
];
---

<section id="experience" class="mb-24 scroll-mt-16">
  <h2 class="sticky top-0 z-10 backdrop-blur-sm bg-slate-900/80 py-6 mb-6 text-sm font-semibold uppercase tracking-widest text-slate-200 lg:hidden">Experience</h2>
  <div class="flex flex-col gap-12">
    {experiences.map((exp) => (
      <div class="grid grid-cols-1 sm:grid-cols-[150px_1fr] gap-2 p-6 rounded-lg transition-all duration-300 hover:bg-slate-800/50 hover:shadow-[0_0_0_1px_rgba(148,163,184,0.1)]">
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">{exp.period}</div>
        <div class="flex flex-col gap-3">
          <h3 class="text-base font-medium text-slate-200 leading-snug">
            <a href={exp.companyUrl} target="_blank" rel="noopener noreferrer" class="">
              {exp.role}
              <br />
              <span class="text-teal-300 transition-colors duration-200 hover:text-teal-200">{exp.company}</span>
            </a>
          </h3>
          <p class="text-slate-400 leading-relaxed text-sm">{exp.description}</p>
          <div class="flex flex-wrap gap-2 mt-2">
            {exp.technologies.map((tech) => (
              <span class="inline-block px-3 py-1 bg-teal-400/10 text-teal-300 rounded-full text-xs font-medium">{tech}</span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
  <a href="/resume.pdf" class="inline-flex items-center gap-2 mt-8 text-slate-200 font-medium transition-all duration-200 hover:text-teal-300 group" target="_blank">
    <span>View Full Résumé</span>
    <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="7" y1="17" x2="17" y2="7"></line>
      <polyline points="7 7 17 7 17 17"></polyline>
    </svg>
  </a>
</section>
