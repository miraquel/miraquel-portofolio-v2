---
import type { BlogPost } from '../lib/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const statusClass = post.status === 'published' 
  ? 'bg-teal-400/10 text-teal-300' 
  : 'bg-slate-600/50 text-slate-400';
---

<div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6 hover:border-slate-600 transition-colors" data-post-id={post.id}>
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1">
      <div class="flex items-center gap-3 mb-2">
        <h3 class="text-xl font-semibold text-slate-200">{post.title}</h3>
        <span class={`px-2 py-1 rounded text-xs font-medium ${statusClass}`}>
          {post.status}
        </span>
      </div>
      <p class="text-slate-400 text-sm mb-3">{post.excerpt}</p>
      <div class="flex items-center gap-4 text-xs text-slate-500">
        <span>{post.author}</span>
        <span>•</span>
        <span>{post.publishedAt.toLocaleDateString()}</span>
        <span>•</span>
        <span>/blog/{post.slug}</span>
      </div>
      {post.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-3">
          {post.tags.map((tag) => (
            <a 
              href={`/blog?tag=${encodeURIComponent(tag)}`}
              target="_blank" 
              class="px-2 pb-1 bg-teal-400/10 hover:bg-teal-600/50 rounded transition-colors"
            >
              <span class="text-teal-300 text-xs">{tag}</span>
            </a>
          ))}
        </div>
      )}
    </div>
    <div class="flex gap-2">
      <a 
        href={`/blog/${post.slug}`}
        target="_blank"
        class="px-3 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded transition-colors text-sm"
        title="View Post"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </a>
      <a 
        href={`/admin/posts/edit/${post.id}`}
        class="px-3 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded transition-colors text-sm"
        title="Edit Post"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
        </svg>
      </a>
      <button 
        class="delete-btn px-3 py-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded transition-colors text-sm"
        title="Delete Post"
        data-post-id={post.id}
        data-post-title={post.title}
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
      </button>
    </div>
  </div>
</div>
