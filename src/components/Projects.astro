    description: "ASP.Net Core API Gateway with CMS for PT. Gunung Raja Paksi. Centralized API management and content management system.",
    projectUrl: "#",
    period: "April 2021 — August 2021",
    technologies: ["ASP.Net Core", ".Net Core 2.1", "C#"]
  },
  {
    title: "Report Transfer Order & Transactional Demand",
