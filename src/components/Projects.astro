    technologies: ["Dynamics AX 2012 R2", "X++", "C#", "Dart", "Flutter"]
  },
  {
    title: "Dynamics AX 2012 R3 Data Forensics",
    description: "Data forensics project for PT. Mega Akses Persada (Fiberstar). Analyzing and investigating data integrity and business process flows in the ERP system.",
    projectUrl: "#",
    period: "June 2023 — July 2023",
