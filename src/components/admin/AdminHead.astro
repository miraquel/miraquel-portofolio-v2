---
// An admin screen's heading, ruled off as the site's section heads are, with the screen's main
// action at the right. Product screens keep fixed sizes, so the heading does not scale with the
// window.
interface Props {
  title: string;
  note?: string;
}

const { title, note } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4 border-b-2 border-form pb-4">
  <div>
    <h1 class="text-[2rem] font-extrabold leading-none tracking-[-0.02em] sm:text-[2.5rem]">{title}</h1>
    {note && <p class="mt-3 max-w-[56ch] text-[0.9375rem] leading-snug text-form">{note}</p>}
  </div>
  <slot />
</div>
