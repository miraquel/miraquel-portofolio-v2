---
// The first viewport: the bill of lading itself, one numbered field per fact.
import CopyEmail from './CopyEmail.astro';
import Field from './Field.astro';
import Guilloche from './Guilloche.astro';
import Mark from './Mark.astro';
import { goods, profile } from '../../data/profile';
import { employers } from '../../data/record';
import { containers, manifest } from '../../data/work';

/** The manifest line that carries a container */
const manifestLine = (slug: string) => manifest.find((line) => line.caseStudy === slug)?.number ?? 0;
import { formatDay, formatMonth, formatPeriod } from '../../lib/format';

const current = employers.find((employer) => !employer.period.end)!;
const [firstName, ...lastNames] = profile.name.split(' ');
---

<section aria-labelledby="shipper-name">
  <div class="mx-auto max-w-[85rem] px-4 pb-16 pt-5 sm:px-8 lg:pb-24 lg:pt-7 short-desktop:pt-3">
    <div data-dark class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-2 border-b-0 border-form bg-form px-4 py-2 text-paper sm:px-5">
      <p class="font-stencil text-[1.375rem] font-extrabold uppercase leading-none tracking-[0.08em]">Bill of lading</p>
      <p class="font-data text-xs">Revised {formatDay(profile.revised)}</p>
    </div>

    {/* Below 1024px the boxes reflow in the order a skimming reader needs them: who ships, where
        from and whether they will move, who they work for, how to reach them. The numbers stay with
        their boxes, as on the printed form. None of the moved boxes holds a link, so focus order is
        unchanged. */}
    <dl class="grid grid-cols-12 gap-px border-2 border-form bg-form">
      <Field n={1} label="Shipper" class="order-1 lg:order-none col-span-12 overflow-hidden lg:col-span-7 lg:row-span-2 lg:pb-7 short-desktop:pt-3 short-desktop:pb-4">
        <Guilloche class="pointer-events-none absolute -right-44 -top-32 w-[34rem] text-form opacity-[0.16] max-lg:hidden" />
        <h1
          id="shipper-name"
          class="relative mt-2 font-stencil text-[clamp(3.5rem,8.4vw,6rem)] font-extrabold uppercase leading-[0.9] short-desktop:text-[4rem] tracking-[0.01em] text-ink"
        >
          {firstName} {lastNames.slice(0, -1).join(' ')}<br />{lastNames.at(-1)}
        </h1>
        <p class="relative mt-4 text-[1.375rem] font-extrabold leading-tight sm:mt-6 sm:text-2xl short-desktop:mt-3">{profile.title}</p>
        {/* The screening facts a recruiter filters on, read from Description of goods (08) */}
        <p class="relative mt-2 flex flex-wrap gap-x-5 gap-y-1 text-[0.9375rem] font-semibold leading-snug">
          {goods.filter((line) => line.quantity).map((line) => (
            <span><span class="font-data font-medium">{line.quantity}</span> {line.short ?? line.goods}</span>
          ))}
        </p>
        <p class="relative mt-3 max-w-[50ch] text-[1.0625rem] leading-relaxed text-pretty short-desktop:max-w-[62ch]">{profile.summary}</p>
      </Field>

      <Field n={2} label="Consignee" class="order-6 lg:order-none col-span-12 lg:col-span-5 short-desktop:py-3">
        <p class="text-balance text-[1.625rem] font-extrabold leading-tight short-desktop:text-[1.375rem]">{profile.roles}</p>
      </Field>

      <Field n={3} label="Notify party" class="order-5 lg:order-none col-span-12 lg:col-span-5 short-desktop:py-3">
        <div data-email-group class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <a
            href={`mailto:${profile.email}`}
            data-contact-email
            class="py-2.5 text-xl font-extrabold underline decoration-form decoration-2 underline-offset-[6px] transition-[text-decoration-thickness] duration-150 wrap-anywhere hover:decoration-4"
          >
            {profile.email}
          </a>
          <CopyEmail email={profile.email} />
        </div>
        <ul class="mt-2 flex flex-wrap gap-x-5 text-[0.9375rem] font-semibold">
          <li><a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="inline-block py-3 underline decoration-form/40 underline-offset-4 hover:decoration-form">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a></li>
          <li><a href={profile.github} target="_blank" rel="noopener noreferrer" class="inline-block py-3 underline decoration-form/40 underline-offset-4 hover:decoration-form">GitHub<span class="sr-only"> (opens in a new tab)</span></a></li>
          <li><a href={profile.resume} type="application/pdf" target="_blank" rel="noopener" class="inline-block py-3 underline decoration-form/40 underline-offset-4 hover:decoration-form">Résumé (PDF)<span class="sr-only"> (opens in a new tab)</span></a></li>
        </ul>
      </Field>

      <Field n={4} label="Port of loading" class="order-2 lg:order-none col-span-12 sm:col-span-4 lg:col-span-3 short-desktop:py-3">
        <p class="text-[1.625rem] font-extrabold leading-tight short-desktop:text-[1.375rem]">{profile.based}</p>
      </Field>

      <Field n={5} label="Port of discharge" live class="order-3 lg:order-none col-span-12 sm:col-span-8 lg:col-span-4 short-desktop:py-3">
        <p class="text-[1.625rem] font-extrabold leading-tight short-desktop:text-[1.375rem]">{profile.discharge.value}</p>
        <p class="mt-1 text-[0.9375rem] font-semibold leading-snug">{profile.discharge.detail}</p>
      </Field>

      <Field n={6} label="Current carrier" live class="order-4 lg:order-none col-span-12 lg:col-span-5 short-desktop:py-3">
        <p class="text-xl font-extrabold leading-tight">{current.company}</p>
        <p class="mt-1 text-[0.9375rem] leading-snug">{current.role}, since {formatMonth(current.period.start)}</p>
      </Field>

      <Field n={7} label="Marks and numbers" class="order-7 lg:order-none col-span-12 short-desktop:py-3">
        <ul class="-mx-4 -mb-4 mt-1 grid gap-px border-t border-form bg-form sm:-mx-5 sm:-mb-5 sm:grid-cols-2 xl:grid-cols-4">
          {containers.map((container) => (
            <li class="bg-paper">
              <a
                href={`#${container.slug}`}
                data-carries={container.carries.join(' ')}
                data-container-link={container.slug}
                class="group flex h-full flex-col gap-2.5 px-4 py-5 transition-colors duration-150 hover:bg-paper-deep sm:px-5"
              >
                <span class="text-xl font-extrabold leading-snug text-balance underline decoration-transparent decoration-2 underline-offset-4 transition-colors duration-150 group-hover:decoration-form">
                  {container.title}
                </span>
                <span class="text-[0.9375rem] leading-snug">{container.line}</span>
                <span class="mt-auto flex flex-col gap-1.5 pt-2">
                  <span class="flex items-center gap-2" aria-hidden="true">
                    <span class:list={['size-3.5 shrink-0', container.steel === 'cobalt' ? 'bg-cobalt' : 'bg-oxide']}></span>
                    <Mark mark={container.mark} size="sm" decorative />
                  </span>
                  <span class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-form">
                    <span class="font-data">{formatPeriod(container.period)}</span>
                    <span class="font-semibold">Manifest line <span class="font-data font-medium">{String(manifestLine(container.slug)).padStart(2, '0')}</span></span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </Field>

      <Field n={8} label="Description of goods" class="order-8 lg:order-none col-span-12" data-goods>
        <table class="w-full text-left sm:-mx-3 sm:w-[calc(100%+1.5rem)]">
          <thead class="sr-only">
            <tr><th scope="col">Quantity</th><th scope="col">Goods</th></tr>
          </thead>
          <tbody>
            {goods.map((line) => (
              <tr data-goods-line={line.id} class="border-t border-form/25 first:border-t-0">
                <td class="w-24 py-2 pr-4 align-baseline font-data text-sm font-semibold whitespace-nowrap sm:w-[8.75rem] sm:pl-3">{line.quantity ?? ''}</td>
                <td class="py-2 align-baseline leading-snug sm:pr-3">
                  <span class="flex flex-wrap gap-x-3">
                    <span class="font-extrabold">{line.goods}</span>
                    <span class="text-ink/80">{line.detail}</span>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </Field>

      <Field n={9} label="Notices" class="order-9 lg:order-none col-span-12 lg:col-span-4" hidden data-notices>
        <a data-notice-link class="text-lg font-extrabold leading-snug underline decoration-form/40 decoration-2 underline-offset-4 hover:decoration-form"></a>
        <p data-notice-date class="mt-1 font-data text-xs text-form"></p>
        <a href="/blog" class="mt-auto inline-block self-start py-3 text-[0.9375rem] font-semibold underline decoration-form/40 underline-offset-4 hover:decoration-form">All posts</a>
      </Field>
    </dl>
  </div>
</section>

<script>
  // Notices: the latest published post, read from Firestore's REST endpoint so the homepage
  // ships no Firebase SDK. Public reads are limited to published posts by firestore.rules.
  // Any failure leaves the field hidden.
  const notices = document.querySelector<HTMLElement>('[data-notices]');
  const goodsField = document.querySelector<HTMLElement>('[data-goods]');
  const projectId = import.meta.env.PUBLIC_FIREBASE_PROJECT_ID;
  const apiKey = import.meta.env.PUBLIC_FIREBASE_API_KEY;

  interface PostRow {
    document?: { fields?: Record<string, { stringValue?: string; timestampValue?: string }> };
  }

  async function showLatestPost() {
    if (!notices || !goodsField || !projectId || !apiKey) return;
    const response = await fetch(
      `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents:runQuery?key=${apiKey}`,
      {
        method: 'POST',
        signal: AbortSignal.timeout(6000),
        body: JSON.stringify({
          structuredQuery: {
            from: [{ collectionId: 'posts' }],
            where: { fieldFilter: { field: { fieldPath: 'status' }, op: 'EQUAL', value: { stringValue: 'published' } } },
            select: { fields: [{ fieldPath: 'title' }, { fieldPath: 'slug' }, { fieldPath: 'publishedAt' }] },
            limit: 100,
          },
        }),
      }
    );
    if (!response.ok) return;

    const rows: PostRow[] = await response.json();
    const latest = rows
      .map((row) => row.document?.fields)
      .filter((fields) => fields?.title?.stringValue && fields?.slug?.stringValue)
      .map((fields) => ({
        title: fields!.title.stringValue!,
        slug: fields!.slug.stringValue!,
        publishedAt: new Date(fields!.publishedAt?.timestampValue ?? 0),
      }))
      .sort((a, b) => b.publishedAt.getTime() - a.publishedAt.getTime())[0];
    if (!latest) return;

    const link = notices.querySelector<HTMLAnchorElement>('[data-notice-link]')!;
    link.href = `/blog/${encodeURIComponent(latest.slug)}`;
    link.textContent = latest.title;
    notices.querySelector('[data-notice-date]')!.textContent = `Posted ${new Intl.DateTimeFormat('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(latest.publishedAt)}`;
    goodsField.classList.add('lg:col-span-8');
    notices.hidden = false;
  }

  showLatestPost().catch(() => {});
</script>
