---
// Certificates and education. A certificate that lapses follows its expiry day: until then it prints
// as current, on a signal slip as the current employer's period does; from then on it carries an
// Expired stamp and is never shown as current.
import SectionHead from './SectionHead.astro';
import Stamp from './Stamp.astro';
import { credentials } from '../../data/record';
import { hasLapsed } from '../../lib/credential';
import { formatDay, formatMonth } from '../../lib/format';
---

<section id="credentials" aria-labelledby="credentials-title" class="scroll-mt-14">
  <div class="mx-auto max-w-[85rem] px-4 pb-16 sm:px-8 lg:pb-24">
    <SectionHead n={13} id="credentials-title" title="Certificates and education" />

    <dl class="mt-8 grid gap-px border-2 border-form bg-form md:grid-cols-2">
      {credentials.map((credential, index) => {
        const lapsed = credential.expires ? hasLapsed(credential.expires) : false;
        return (
          <div class:list={['grid grid-cols-[minmax(0,1fr)_auto] content-start gap-x-6 bg-paper px-4 py-5 sm:px-6', index === 0 && 'md:col-span-2']}>
            <dt class="text-lg font-extrabold leading-snug">{credential.name}</dt>
            <dd class="col-start-1 mt-1 text-[0.9375rem] leading-snug">{credential.detail}</dd>
            {credential.expires && !lapsed && (
              <dd class="col-start-1 mt-2">
                <span class="signal-stock inline-block px-2 py-1 font-data text-sm font-semibold">
                  Valid until {formatDay(credential.expires)}
                </span>
              </dd>
            )}
            {credential.expires && lapsed && (
              <dd class="col-start-2 row-span-2 row-start-1 self-center">
                <Stamp word="Expired" date={formatMonth(credential.expires.slice(0, 7))} />
              </dd>
            )}
          </div>
        );
      })}
    </dl>
  </div>
</section>
