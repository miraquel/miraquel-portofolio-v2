---
// One numbered box of the bill of lading. Renders a dt/dd pair, so it must sit inside a <dl>.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  n: number;
  label: string;
  /** Live facts (the current carrier, the open port of discharge) print on signal yellow */
  live?: boolean;
}

const { n, label, live = false, class: className, ...rest } = Astro.props;
---

<div class:list={['relative flex flex-col gap-2.5 px-4 py-4 sm:px-5 sm:py-5', live ? 'bg-signal' : 'bg-paper', className]} {...rest}>
  <dt class="flex items-baseline gap-2 text-[0.8125rem] font-semibold leading-tight text-form">
    <span class="font-data text-xs font-medium">{String(n).padStart(2, '0')}</span>
    {label}
  </dt>
  <dd class="flex flex-1 flex-col"><slot /></dd>
</div>
