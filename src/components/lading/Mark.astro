---
// An ISO 6346 container mark: owner code, serial, and the check digit in its box.
import type { ContainerMark } from '../../lib/container-mark';

interface Props {
  mark: ContainerMark;
  size?: 'sm' | 'md';
  /** Inside a link that already names the project: hidden, so the link reads title first */
  decorative?: boolean;
  class?: string;
}

const { mark, size = 'sm', decorative = false, class: className } = Astro.props;
// Standalone, the mark is an image with a spoken name; its parts are presentational
const name = `Container ${mark.owner} ${mark.serial}, check digit ${mark.check}`;
---

<span
  class:list={[
    'inline-flex items-center whitespace-nowrap font-stencil font-extrabold uppercase leading-none tracking-[0.04em]',
    size === 'md' && 'gap-[0.3em] text-[1.875rem]',
    size === 'sm' && 'gap-[0.3em] text-[1.25rem]',
    className,
  ]}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : name}
  aria-hidden={decorative ? 'true' : undefined}
>
  <span>{mark.owner}</span>
  <span>{mark.serial}</span>
  <span class="border-[0.07em] border-current px-[0.14em] leading-[0.95]">{mark.check}</span>
</span>
