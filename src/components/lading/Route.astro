---
// A case study's data flow, drawn from data: stops top to bottom, and between each pair of
// stops the legs naming what travels. Returns are the flows that come back.
import type { CaseStudy } from '../../data/work';

interface Props {
  route: CaseStudy['route'];
}

const { route } = Astro.props;
---

<ol class="mt-5">
  {route.stops.map((stop, index) => {
    const legs = route.legs[index];
    const next = route.stops[index + 1];
    return (
      <li>
        <div class="border-2 border-ink bg-paper px-4 py-3.5 sm:px-5">
          <p class="flex items-baseline gap-2.5 text-lg font-extrabold leading-snug">
            <span class="font-data text-xs font-medium text-form">{String.fromCharCode(65 + index)}</span>
            {stop.name}
          </p>
          <p class="mt-1 text-[0.9375rem] leading-snug">{stop.does}</p>
          <p class="mt-2 font-data text-xs text-form">{stop.tech}</p>
        </div>
        {legs && next && (
          <ul class="flex flex-wrap gap-x-8 gap-y-1 py-1 pl-5" aria-label={`From ${stop.name} to ${next.name}`}>
            {legs.map((leg) => (
              <li class="flex items-center gap-3">
                <svg class="h-14 w-4 shrink-0 text-ink" viewBox="0 0 16 56" aria-hidden="true">
                  <path d="M8 0V50" stroke="currentColor" stroke-width="2" />
                  <path d="M2 43L8 53L14 43" fill="none" stroke="currentColor" stroke-width="2" />
                </svg>
                <span class="max-w-[26ch] text-sm font-semibold leading-snug text-form">{leg}</span>
              </li>
            ))}
          </ul>
        )}
      </li>
    );
  })}
</ol>

{route.returns.length > 0 && (
  <ul class="mt-5 space-y-2 border-t border-form/40 pt-4">
    {route.returns.map((flow) => (
      <li class="flex gap-3 text-[0.9375rem] leading-snug">
        <svg class="mt-0.5 h-4 w-5 shrink-0 text-form" viewBox="0 0 20 16" aria-hidden="true">
          <path d="M18 2V9H4" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M8 4L3 9L8 14" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
        {flow}
      </li>
    ))}
  </ul>
)}
