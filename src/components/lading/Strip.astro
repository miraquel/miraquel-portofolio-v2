---
// The thin printed strip above the document: who it belongs to, and the way around it.
interface Props {
  /** On the homepage section links stay in-page; elsewhere they lead back to it */
  onHome?: boolean;
}

const { onHome = false } = Astro.props;
const base = onHome ? '' : '/';

// Phones keep three: the work, the blog and the contact block. 'Work' is the phone's short
// label for the case studies, which the manifest of all projects follows. Below 360px only
// Work and Contact fit beside the name; Blog stays one tap away in the footer.
const links = [
  { href: `${base}#containers`, label: 'Work', show: 'phone' },
  { href: `${base}#containers`, label: 'Case studies', show: 'wide' },
  { href: `${base}#manifest`, label: 'All projects', show: 'wide' },
  { href: `${base}#employers`, label: 'Employers', show: 'wide' },
  { href: '/blog', label: 'Blog', show: 'from-360' },
  { href: `${base}#contact`, label: 'Contact', show: 'all' },
];
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-2 focus:z-50 focus:bg-signal focus:px-4 focus:py-2.5 focus:font-semibold focus:text-ink"
>
  Skip to content
</a>
<header class="sticky top-0 z-40 border-b-2 border-form bg-paper">
  <div class="mx-auto flex max-w-[85rem] items-center justify-between gap-3 px-4 sm:px-8 md:gap-6">
    <a href="/" class="inline-flex min-h-11 shrink-0 items-center font-stencil text-base font-extrabold uppercase leading-none tracking-[0.05em] text-ink min-[380px]:text-[1.125rem] md:text-[1.375rem]">
      Chaidir Ali Assegaf
    </a>
    <nav aria-label="Page">
      <ul class="flex items-center">
        {links.map((link) => (
          <li class:list={[link.show === 'wide' && 'hidden md:block', link.show === 'phone' && 'md:hidden', link.show === 'from-360' && 'max-[359px]:hidden']}>
            <a
              href={link.href}
              class="inline-block px-2 py-[15px] text-sm font-semibold leading-none text-form underline-offset-4 transition-colors duration-150 hover:text-ink hover:underline md:px-2.5"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
