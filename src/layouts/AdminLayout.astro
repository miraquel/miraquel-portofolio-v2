---
import '../styles/global.css';
import '../styles/admin.css';

interface Props {
  title?: string;
}

const { title = 'Admin Panel' } = Astro.props;
const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === '/admin') return currentPath === '/admin';
  if (path === '/admin/posts/new') return currentPath.startsWith('/admin/posts/new');
  if (path === '/admin/posts') return currentPath.startsWith('/admin/posts') && !currentPath.startsWith('/admin/posts/new');
  return false;
};

const navItems = [
  { href: '/admin', label: 'Dashboard', icon: 'home' },
  { href: '/admin/posts', label: 'Blog Posts', icon: 'document' },
  { href: '/admin/posts/new', label: 'New Post', icon: 'plus' }
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Chaidir Ali Assegaf</title>
  </head>
  <body class="admin-shell">
    <div class="admin-frame">
      <aside class="admin-sidebar">
        <a href="/admin" class="admin-brand">
          <span class="admin-brand-mark">CA</span>
          <span class="admin-brand-copy">
            <strong>Content Studio</strong>
            <span>Portfolio admin</span>
          </span>
        </a>

        <nav class="admin-nav" aria-label="Admin navigation">
          <div class="admin-nav-label">Workspace</div>
          {navItems.map(item => (
            <a href={item.href} class={`admin-nav-link ${isActive(item.href) ? 'is-active' : ''}`}>
              {item.icon === 'home' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/></svg>}
              {item.icon === 'document' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h9l3 3v15H6z"/><path d="M9 11h6M9 15h6"/></svg>}
              {item.icon === 'plus' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg>}
              <span>{item.label}</span>
            </a>
          ))}
        </nav>

        <div class="admin-sidebar-footer">
          <a href="/" target="_blank" rel="noopener noreferrer" class="admin-sidebar-action">
            <span>View live site</span><span>↗</span>
          </a>
          <button class="admin-sidebar-action js-logout">
            <span>Sign out</span><span>→</span>
          </button>
        </div>
      </aside>

      <div class="admin-workspace">
        <header class="admin-mobile-header">
          <span class="admin-mobile-brand">Content Studio</span>
          <span class="admin-mobile-actions">
            <a href="/" target="_blank" rel="noopener noreferrer">View site ↗</a>
            <button class="admin-mobile-logout js-logout">Sign out</button>
          </span>
        </header>

        <main class="admin-main">
          <slot />
        </main>

        <nav class="admin-mobile-nav" aria-label="Mobile admin navigation">
          {navItems.map(item => (
            <a href={item.href} class={`admin-nav-link ${isActive(item.href) ? 'is-active' : ''}`}>
              {item.icon === 'home' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/></svg>}
              {item.icon === 'document' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h9l3 3v15H6z"/><path d="M9 11h6M9 15h6"/></svg>}
              {item.icon === 'plus' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg>}
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
      </div>
    </div>

    <script>
      import { auth } from '../lib/firebase';
      import { signOut, onAuthStateChanged } from 'firebase/auth';
      import { isAdmin } from '../lib/admin';

      onAuthStateChanged(auth, async user => {
        if (!(await isAdmin(user)) && !window.location.pathname.includes('/admin/login')) {
          await signOut(auth);
          window.location.replace('/admin/login');
        }
      });

      document.querySelectorAll('.js-logout').forEach(button => {
        button.addEventListener('click', async () => {
          try {
            await signOut(auth);
            window.location.href = '/admin/login';
          } catch (error) {
            console.error('Logout failed:', error);
          }
        });
      });
    </script>
  </body>
</html>
