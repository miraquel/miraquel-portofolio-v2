---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Admin Panel' } = Astro.props;
const currentPath = Astro.url.pathname;

// Determine active state
const isActive = (path: string) => {
  if (path === '/admin' && currentPath === '/admin') return true;
  if (path === '/admin/posts' && currentPath === '/admin/posts') return true;
  if (path === '/admin/posts/new' && currentPath.startsWith('/admin/posts/new')) return true;
  return false;
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <title>{title} - Chaidir Ali Assegaf</title>
  </head>
  <body class="m-0 w-full min-h-screen bg-slate-900 text-slate-400 font-sans leading-normal">
    <!-- Admin Navigation -->
    <nav class="bg-slate-800/50 backdrop-blur-sm border-b border-slate-700 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 py-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-8">
            <h1 class="text-xl font-bold text-slate-200">Admin Panel</h1>
            <div class="hidden md:flex gap-4">
              <a 
                href="/admin" 
                class={`group px-4 py-2 transition-colors rounded-lg ${
                  isActive('/admin') 
                    ? 'bg-slate-700/70' 
                    : 'hover:bg-slate-700/50'
                }`}
              >
                <span class={`transition-colors ${
                  isActive('/admin')
                    ? 'text-teal-300 font-medium'
                    : 'text-slate-300 group-hover:text-teal-300'
                }`}>Dashboard</span>
              </a>
              <a 
                href="/admin/posts" 
                class={`group px-4 py-2 transition-colors rounded-lg ${
                  isActive('/admin/posts') 
                    ? 'bg-slate-700/70' 
                    : 'hover:bg-slate-700/50'
                }`}
              >
                <span class={`transition-colors ${
                  isActive('/admin/posts')
                    ? 'text-teal-300 font-medium'
                    : 'text-slate-300 group-hover:text-teal-300'
                }`}>Blog Posts</span>
              </a>
              <a 
                href="/admin/posts/new" 
                class={`group px-4 py-2 transition-colors rounded-lg ${
                  isActive('/admin/posts/new') 
                    ? 'bg-slate-700/70' 
                    : 'hover:bg-slate-700/50'
                }`}
              >
                <span class={`transition-colors ${
                  isActive('/admin/posts/new')
                    ? 'text-teal-300 font-medium'
                    : 'text-slate-300 group-hover:text-teal-300'
                }`}>
                  New Post
                </span>
              </a>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <a href="/" target="_blank" class="text-slate-400 hover:text-teal-300 transition-colors">
              View Site →
            </a>
            <button id="logoutButton" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg transition-colors">
              Logout
            </button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-6 py-8">
      <slot />
    </main>

    <!-- Auth Check Script -->
    <script>
      import { auth } from '../lib/firebase';
      import { signOut, onAuthStateChanged } from 'firebase/auth';
      import { isAdmin } from '../lib/admin';

      // Check authentication
      onAuthStateChanged(auth, async (user) => {
        if (!(await isAdmin(user)) && !window.location.pathname.includes('/admin/login')) {
          await signOut(auth);
          window.location.replace('/admin/login');
        }
      });

      // Logout handler
      const logoutButton = document.getElementById('logoutButton');
      logoutButton?.addEventListener('click', async () => {
        try {
          await signOut(auth);
          window.location.href = '/admin/login';
        } catch (error) {
          console.error('Logout failed:', error);
        }
      });
    </script>
  </body>
</html>
