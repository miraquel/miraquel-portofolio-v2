---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/firebase';
import { collection, getDocs, query, orderBy } from 'firebase/firestore';
import { getAllStatuses, type Status } from '../../lib/blog';
import { Icon } from 'astro-icon/components';

export const prerender = false;

let totalPosts = 0;
let statusStats: Array<Status & { count: number }> = [];

try {
  // Get all statuses from master collection
  const statuses = await getAllStatuses();
  
  // Get all posts
  const querySnapshot = await getDocs(collection(db, 'posts'));
  totalPosts = querySnapshot.size;

  // Count posts by status
  const statusCounts: Record<string, number> = {};
  querySnapshot.forEach((doc) => {
    const data = doc.data();
    const status = data.status || 'published';
    statusCounts[status] = (statusCounts[status] || 0) + 1;
  });

  // Combine statuses with their counts
  statusStats = statuses.map(status => ({
    ...status,
    count: statusCounts[status.name] || 0
  })).sort((a, b) => a.order - b.order);
} catch (error) {
  console.error('Error loading stats:', error);
}
---

<AdminLayout title="Dashboard">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-200 mb-2">Dashboard</h1>
    <p class="text-slate-400">Welcome to your admin panel</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-medium text-slate-400">Total Posts</h3>
        <svg class="w-8 h-8 text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
        </svg>
      </div>
      <div class="text-3xl font-bold text-slate-200">{totalPosts}</div>
    </div>

    {statusStats.map((status) => (
      <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-medium text-slate-400">{status.displayName}</h3>
          <Icon 
            name={status.icon}
            class="w-8 h-8" 
            style={`color: ${status.color}`}
          />
        </div>
        <div class="text-3xl font-bold text-slate-200">{status.count}</div>
      </div>
    ))}
  </div>

  <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
    <h2 class="text-xl font-bold text-slate-200 mb-4">Quick Actions</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a 
        href="/admin/posts/new" 
        class="flex items-center gap-3 p-4 bg-slate-700/50 hover:bg-slate-700 rounded-lg transition-colors group"
      >
        <svg class="w-6 h-6 text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <div>
          <h3 class="font-medium text-slate-200 group-hover:text-teal-300">Create New Post</h3>
          <p class="text-sm text-slate-400">Write a new blog post</p>
        </div>
      </a>

      <a 
        href="/admin/posts" 
        class="flex items-center gap-3 p-4 bg-slate-700/50 hover:bg-slate-700 rounded-lg transition-colors group"
      >
        <svg class="w-6 h-6 text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <div>
          <h3 class="font-medium text-slate-200 group-hover:text-teal-300">Manage Posts</h3>
          <p class="text-sm text-slate-400">View and edit all posts</p>
        </div>
      </a>
    </div>
  </div>
</AdminLayout>
