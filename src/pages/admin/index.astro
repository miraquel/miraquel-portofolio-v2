---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="Dashboard">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-200 mb-2">Dashboard</h1>
    <p class="text-slate-400">Overview of your blog content</p>
  </div>

  <div id="loadingStats" class="text-slate-400">Loading dashboard…</div>
  <div id="stats" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8"></div>
  <div id="statsError" class="hidden p-4 rounded-lg bg-red-500/10 text-red-400"></div>

  <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
    <h2 class="text-xl font-bold text-slate-200 mb-4">Quick Actions</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/admin/posts/new" class="p-4 bg-slate-700/50 hover:bg-slate-700 rounded-lg text-teal-300">Create New Post</a>
      <a href="/admin/posts" class="p-4 bg-slate-700/50 hover:bg-slate-700 rounded-lg text-teal-300">Manage Posts</a>
    </div>
  </div>
</AdminLayout>

<script>
  import { onAuthStateChanged } from 'firebase/auth';
  import { collection, getDocs, orderBy, query } from 'firebase/firestore';
  import { auth, db } from '../../lib/firebase';
  import { isAdmin } from '../../lib/admin';

  const loading = document.getElementById('loadingStats')!;
  const stats = document.getElementById('stats')!;
  const errorBox = document.getElementById('statsError')!;

  onAuthStateChanged(auth, async user => {
    if (!(await isAdmin(user))) return;

    try {
      const [statusesSnapshot, postsSnapshot] = await Promise.all([
        getDocs(query(collection(db, 'statuses'), orderBy('order', 'asc'))),
        getDocs(collection(db, 'posts'))
      ]);
      const counts: Record<string, number> = {};
      postsSnapshot.forEach(post => {
        const status = post.data().status || 'draft';
        counts[status] = (counts[status] || 0) + 1;
      });

      const cards = [
        { label: 'Total Posts', count: postsSnapshot.size, color: '#5eead4' },
        ...statusesSnapshot.docs
          .map(status => status.data())
          .filter(status => status.isActive)
          .map(status => ({ label: status.displayName, count: counts[status.name] || 0, color: status.color }))
      ];

      for (const card of cards) {
        const element = document.createElement('div');
        element.className = 'bg-slate-800/50 border border-slate-700 rounded-lg p-6';
        const label = document.createElement('div');
        label.className = 'text-sm text-slate-400 mb-2';
        label.textContent = String(card.label);
        const count = document.createElement('div');
        count.className = 'text-3xl font-bold';
        count.style.color = String(card.color);
        count.textContent = String(card.count);
        element.append(label, count);
        stats.append(element);
      }

      loading.classList.add('hidden');
      stats.classList.remove('hidden');
    } catch (error) {
      loading.classList.add('hidden');
      errorBox.textContent = error instanceof Error ? error.message : 'Failed to load dashboard.';
      errorBox.classList.remove('hidden');
    }
  });
</script>
