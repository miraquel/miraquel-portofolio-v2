---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="Dashboard">
  <header class="admin-page-header">
    <div>
      <div class="admin-eyebrow">Workspace</div>
      <h1 class="admin-page-title">Dashboard</h1>
      <p class="admin-page-description">A focused view of your publishing activity.</p>
    </div>
    <a href="/admin/posts/new" class="admin-primary-button">Create post <span aria-hidden="true">＋</span></a>
  </header>

  <div id="loadingStats" class="admin-page-description">Loading publishing data…</div>
  <div id="stats" class="admin-metric-rail hidden"></div>
  <div id="statsError" class="hidden p-4 rounded-lg bg-red-500/10 text-red-400"></div>

  <section class="admin-command-section">
    <div>
      <h2 class="admin-section-title">Continue working</h2>
      <p class="admin-section-copy">Jump back into the two tasks you use most.</p>
    </div>
    <div class="admin-command-list">
      <a href="/admin/posts/new" class="admin-command">
        <span><strong>Write a new post</strong><span>Start in the editor with a clean draft.</span></span>
        <span aria-hidden="true">→</span>
      </a>
      <a href="/admin/posts" class="admin-command">
        <span><strong>Review your library</strong><span>Edit, filter, publish, or archive existing work.</span></span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</AdminLayout>

<script>
  import { onAuthStateChanged } from 'firebase/auth';
  import { collection, getDocs, orderBy, query } from 'firebase/firestore';
  import { auth, db } from '../../lib/firebase';
  import { isAdmin } from '../../lib/admin';

  const loading = document.getElementById('loadingStats')!;
  const stats = document.getElementById('stats')!;
  const errorBox = document.getElementById('statsError')!;

  onAuthStateChanged(auth, async user => {
    if (!(await isAdmin(user))) return;

    try {
      const [statusesSnapshot, postsSnapshot] = await Promise.all([
        getDocs(query(collection(db, 'statuses'), orderBy('order', 'asc'))),
        getDocs(collection(db, 'posts'))
      ]);
      const counts: Record<string, number> = {};
      postsSnapshot.forEach(post => {
        const status = post.data().status || 'draft';
        counts[status] = (counts[status] || 0) + 1;
      });

      const cards = [
        { label: 'Total Posts', count: postsSnapshot.size, color: '#5eead4' },
        ...statusesSnapshot.docs
          .map(status => status.data())
          .filter(status => status.isActive)
          .map(status => ({ label: status.displayName, count: counts[status.name] || 0, color: status.color }))
      ];

      for (const card of cards) {
        const element = document.createElement('div');
        element.className = 'admin-metric';
        const label = document.createElement('div');
        label.className = 'admin-metric-label';
        label.textContent = String(card.label);
        const count = document.createElement('div');
        count.className = 'admin-metric-value';
        count.textContent = String(card.count);
        element.append(label, count);
        stats.append(element);
      }

      loading.classList.add('hidden');
      stats.classList.remove('hidden');
    } catch (error) {
      loading.classList.add('hidden');
      errorBox.textContent = error instanceof Error ? error.message : 'Failed to load dashboard.';
      errorBox.classList.remove('hidden');
    }
  });
</script>
