---
import Layout from '../../layouts/Layout.astro';
import '../../styles/admin.css';
---

<Layout>
  <div class="admin-login-page">
    <section class="admin-login-intro">
      <div class="admin-login-wordmark">Chaidir Ali Assegaf · Content Studio</div>
      <div class="admin-login-intro-copy">
        <div class="admin-eyebrow">Private workspace</div>
        <h1>Write with focus.<br />Publish with intent.</h1>
        <p>A quiet workspace for shaping articles, managing drafts, and keeping your portfolio current.</p>
      </div>
      <div class="admin-login-footnote">Portfolio publishing system</div>
    </section>

    <section class="admin-login-panel">
      <div class="admin-login-form-wrap">
        <h2>Welcome back</h2>
        <p>Sign in to continue to your workspace.</p>

        <form id="loginForm" class="space-y-5">
          <div>
            <label for="email">Email address</label>
            <input type="email" id="email" required autocomplete="email" placeholder="admin@example.com" />
          </div>

          <div>
            <label for="password">Password</label>
            <input type="password" id="password" required autocomplete="current-password" placeholder="••••••••" />
          </div>

          <div id="errorMessage" class="hidden p-3 bg-red-500/10 border border-red-500/30 rounded-lg text-red-400 text-xs"></div>

          <button type="submit" id="loginButton" class="admin-login-submit">Sign in</button>
        </form>

        <a href="/" class="admin-login-back">← Return to portfolio</a>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { auth } from '../../lib/firebase';
  import { signInWithEmailAndPassword, signOut } from 'firebase/auth';
  import { isAdmin } from '../../lib/admin';

  const form = document.getElementById('loginForm') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLDivElement;
  const loginButton = document.getElementById('loginButton') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const email = emailInput.value;
    const password = passwordInput.value;

    // Hide previous error
    errorMessage.classList.add('hidden');
    
    // Disable button during login
    loginButton.disabled = true;
    loginButton.textContent = 'Signing in...';

    try {
      const credential = await signInWithEmailAndPassword(auth, email, password);
      if (!(await isAdmin(credential.user))) {
        await signOut(auth);
        throw new Error('This account does not have administrator access.');
      }
      // Redirect to admin dashboard
      window.location.href = '/admin';
    } catch (error: any) {
      // Show error message
      errorMessage.classList.remove('hidden');
      errorMessage.textContent = error.message || 'Failed to sign in. Please check your credentials.';
      
      // Re-enable button
      loginButton.disabled = false;
      loginButton.textContent = 'Sign in';
    }
  });

  // Check if already logged in
  auth.onAuthStateChanged(async (user) => {
    if (await isAdmin(user)) {
      window.location.href = '/admin';
    }
  });
</script>
