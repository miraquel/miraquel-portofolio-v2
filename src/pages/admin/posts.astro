---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="Blog Posts">
  <header class="admin-page-header">
    <div>
      <div class="admin-eyebrow">Content library</div>
      <h1 class="admin-page-title">Blog posts</h1>
      <p class="admin-page-description">Find, review, and manage everything you have written.</p>
    </div>
    <a href="/admin/posts/new" class="admin-primary-button">New post <span aria-hidden="true">＋</span></a>
  </header>

  <div id="postFilters" class="admin-filterbar hidden"></div>
  <div id="loadingPosts" class="admin-page-description">Loading your library…</div>
  <div id="postsError" class="hidden p-4 rounded-lg bg-red-500/10 text-red-400"></div>
  <div id="posts" class="admin-post-list hidden"></div>
</AdminLayout>

<script>
  import { onAuthStateChanged } from 'firebase/auth';
  import { collection, getDocs } from 'firebase/firestore';
  import { auth, db } from '../../lib/firebase';
  import { isAdmin } from '../../lib/admin';
  import { deletePost } from '../../lib/post-writes';

  const loading = document.getElementById('loadingPosts')!;
  const posts = document.getElementById('posts')!;
  const filters = document.getElementById('postFilters')!;
  const errorBox = document.getElementById('postsError')!;
  const searchParams = new URLSearchParams(window.location.search);
  const selectedStatus = searchParams.get('status');
  const selectedTag = searchParams.get('tag');

  function textElement(tag: string, value: unknown, className: string): HTMLElement {
    const element = document.createElement(tag);
    element.className = className;
    element.textContent = String(value ?? '');
    return element;
  }

  function filterLink(label: string, param: 'status' | 'tag', value: string | null, active: boolean): HTMLAnchorElement {
    const link = document.createElement('a');
    const params = new URLSearchParams(window.location.search);
    value ? params.set(param, value) : params.delete(param);
    link.href = params.size ? `/admin/posts?${params}` : '/admin/posts';
    link.className = `admin-filter-chip ${active ? 'is-active' : ''}`;
    link.textContent = label;
    return link;
  }

  onAuthStateChanged(auth, async user => {
    if (!(await isAdmin(user))) return;

    try {
      const snapshot = await getDocs(collection(db, 'posts'));
      const allPostData = snapshot.docs
        .map(post => ({ id: post.id, ...post.data() }))
        .sort((a: any, b: any) => (b.publishedAt?.toMillis?.() || 0) - (a.publishedAt?.toMillis?.() || 0));

      const statuses = [...new Set((allPostData as any[]).map(post => post.status || 'draft'))].sort();
      const tags = [...new Set((allPostData as any[]).flatMap(post => post.tags || []))].sort();
      const statusRow = document.createElement('div');
      statusRow.className = 'admin-filter-row';
      statusRow.append(filterLink('All statuses', 'status', null, !selectedStatus));
      for (const status of statuses) statusRow.append(filterLink(status, 'status', status, selectedStatus === status));
      const tagRow = document.createElement('div');
      tagRow.className = 'admin-filter-row';
      tagRow.append(filterLink('All tags', 'tag', null, !selectedTag));
      for (const tag of tags) tagRow.append(filterLink(tag, 'tag', tag, selectedTag === tag));
      filters.append(statusRow, tagRow);
      filters.classList.remove('hidden');

      const postData = (allPostData as any[]).filter(post =>
        (!selectedStatus || (post.status || 'draft') === selectedStatus)
        && (!selectedTag || (post.tags || []).includes(selectedTag))
      );

      for (const post of postData) {
        const card = document.createElement('article');
        card.className = 'admin-post-row';
        const details = document.createElement('div');
        details.append(
          textElement('h2', post.title, 'admin-post-title'),
          textElement('p', post.excerpt, 'admin-post-excerpt'),
          textElement('span', post.status || 'draft', 'admin-post-status')
        );

        const actions = document.createElement('div');
        actions.className = 'admin-post-actions';
        const view = document.createElement('a');
        view.href = `/blog/${encodeURIComponent(post.slug)}`;
        view.target = '_blank';
        view.rel = 'noopener noreferrer';
        view.className = 'admin-action-button';
        view.textContent = 'View';
        const edit = document.createElement('a');
        edit.href = `/admin/posts/edit/${encodeURIComponent(post.id)}`;
        edit.className = 'admin-action-button';
        edit.textContent = 'Edit';
        const remove = document.createElement('button');
        remove.className = 'admin-action-button is-danger';
        remove.textContent = 'Delete';
        remove.addEventListener('click', async () => {
          if (!confirm(`Delete "${post.title}"? This cannot be undone.`)) return;
          try {
            remove.setAttribute('disabled', 'true');
            await deletePost(post.id, post.slug);
            card.remove();
          } catch (error) {
            remove.removeAttribute('disabled');
            alert(error instanceof Error ? error.message : 'Failed to delete post.');
          }
        });
        actions.append(view, edit, remove);
        card.append(details, actions);
        posts.append(card);
      }

      if (postData.length === 0) posts.append(textElement('p', 'No posts match these filters.', 'admin-page-description'));
      loading.classList.add('hidden');
      posts.classList.remove('hidden');
    } catch (error) {
      loading.classList.add('hidden');
      errorBox.textContent = error instanceof Error ? error.message : 'Failed to load posts.';
      errorBox.classList.remove('hidden');
    }
  });
</script>
