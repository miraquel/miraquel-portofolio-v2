---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminHead from '../../../../components/admin/AdminHead.astro';
import PostForm from '../../../../components/admin/PostForm.astro';
import { getAllStatuses } from '../../../../lib/blog';
import { notice, pending, textAction } from '../../../../lib/admin-ui';
import '../../../../styles/post-body.css';
import '../../../../styles/admin.css';

export const prerender = false;

const { id } = Astro.params;
const statuses = await getAllStatuses();
---

<AdminLayout title="Edit post">
  <AdminHead title="Edit post" note="Change the writing or how it is published. Nothing changes on the blog until you save." />
  <p id="loadingMessage" role="status" class={`mt-8 ${pending}`}>Loading the post…</p>
  <div id="loadProblem" class="mt-8 space-y-3" hidden>
    <p id="loadProblemText" role="alert" class={notice}></p>
    <a href="/admin/posts" class={textAction}>Back to all posts</a>
  </div>
  <PostForm statuses={statuses} postId={id} submitLabel="Save changes" />
</AdminLayout>

<script>
  import { onAuthStateChanged } from 'firebase/auth';
  import { deleteField, doc, getDoc, Timestamp } from 'firebase/firestore';
  import { auth, db } from '../../../../lib/firebase';
  import { isAdmin } from '../../../../lib/admin';
  import { updatePost } from '../../../../lib/post-writes';
  import { readPostFields, startEditor, toLocalInput, wireStatusStamp } from '../../../../lib/post-editor';

  const form = document.getElementById('postForm') as HTMLFormElement;
  const postId = (document.getElementById('postId') as HTMLInputElement)?.value;
  const loadingMessage = document.getElementById('loadingMessage') as HTMLParagraphElement;
  const loadProblem = document.getElementById('loadProblem') as HTMLDivElement;
  const loadProblemText = document.getElementById('loadProblemText') as HTMLParagraphElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLParagraphElement;
  const submitButton = document.getElementById('submitButton') as HTMLButtonElement;
  let originalSlug = '';

  function cannotLoad(message: string) {
    loadingMessage.hidden = true;
    loadProblemText.textContent = message;
    loadProblem.hidden = false;
  }

  async function loadPost() {
    if (!postId) return cannotLoad('This address names no post.');

    try {
      const snapshot = await getDoc(doc(db, 'posts', postId));
      if (!snapshot.exists()) return cannotLoad("This post doesn't exist. It may have been deleted.");

      const data = snapshot.data();
      originalSlug = data.slug;

      const set = (id: string, value: string) => ((document.getElementById(id) as HTMLInputElement).value = value);
      set('title', data.title);
      set('slug', data.slug);
      set('excerpt', data.excerpt);
      set('author', data.author);
      set('imageUrl', data.imageUrl || '');
      set('tags', (data.tags || []).join(', '));
      set('status', data.status || 'published');
      set('readingTime', data.readingTime || '');
      set('publishedAt', toLocalInput(data.publishedAt.toDate()));
      wireStatusStamp();

      loadingMessage.hidden = true;
      form.hidden = false;
      await startEditor(data.content);
    } catch (error) {
      console.error('Error loading post:', error);
      cannotLoad(`Couldn't load the post: ${error instanceof Error ? error.message : 'unknown error'}. Reload the page to try again.`);
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMessage.hidden = true;
    submitButton.disabled = true;
    submitButton.textContent = 'Saving…';

    try {
      const { publishedAt, imageUrl, readingTime, ...fields } = readPostFields();
      await updatePost(postId, originalSlug, {
        ...fields,
        publishedAt: Timestamp.fromDate(publishedAt),
        updatedAt: Timestamp.now(),
        imageUrl: imageUrl || deleteField(),
        readingTime: readingTime ?? deleteField(),
      });
      window.location.href = '/admin/posts';
    } catch (error) {
      console.error('Error updating post:', error);
      errorMessage.textContent = `Couldn't save the post: ${error instanceof Error && error.message ? error.message : 'unknown error'}. Your changes are still here; try again.`;
      errorMessage.hidden = false;
      submitButton.disabled = false;
      submitButton.textContent = 'Save changes';
    }
  });

  onAuthStateChanged(auth, async (user) => {
    if (await isAdmin(user)) await loadPost();
  });
</script>
