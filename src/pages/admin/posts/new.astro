---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminHead from '../../../components/admin/AdminHead.astro';
import PostForm from '../../../components/admin/PostForm.astro';
import { getAllStatuses } from '../../../lib/blog';
import '../../../styles/post-body.css';
import '../../../styles/admin.css';

export const prerender = false;

const statuses = await getAllStatuses();
---

<AdminLayout title="New post">
  <AdminHead title="New post" note="Write the post, then set how and when it is published." />
  <PostForm statuses={statuses} submitLabel="Create post" />
</AdminLayout>

<script>
  import { Timestamp } from 'firebase/firestore';
  import { createPost } from '../../../lib/post-writes';
  import { readPostFields, startEditor, toLocalInput, wireStatusStamp } from '../../../lib/post-editor';

  const form = document.getElementById('postForm') as HTMLFormElement;
  const titleInput = document.getElementById('title') as HTMLInputElement;
  const slugInput = document.getElementById('slug') as HTMLInputElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLParagraphElement;
  const submitButton = document.getElementById('submitButton') as HTMLButtonElement;

  startEditor().catch((error) => console.error('Error initializing editor:', error));

  // The slug follows the title until it is edited by hand
  let slugEdited = false;
  slugInput.addEventListener('input', () => (slugEdited = slugInput.value.length > 0));
  titleInput.addEventListener('input', () => {
    if (slugEdited) return;
    slugInput.value = titleInput.value
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
  });

  // A new post is dated now
  (document.getElementById('publishedAt') as HTMLInputElement).value = toLocalInput(new Date());
  wireStatusStamp();

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMessage.hidden = true;
    submitButton.disabled = true;
    submitButton.textContent = 'Creating…';

    try {
      const { publishedAt, imageUrl, readingTime, ...fields } = readPostFields();
      const postData: Record<string, unknown> = {
        ...fields,
        publishedAt: Timestamp.fromDate(publishedAt),
        createdAt: Timestamp.now(),
        updatedAt: Timestamp.now(),
      };
      if (imageUrl) postData.imageUrl = imageUrl;
      if (readingTime) postData.readingTime = readingTime;

      await createPost(postData);
      window.location.href = '/admin/posts';
    } catch (error) {
      console.error('Error creating post:', error);
      errorMessage.textContent = `Couldn't create the post: ${error instanceof Error && error.message ? error.message : 'unknown error'}. Your writing is still here; try again.`;
      errorMessage.hidden = false;
      submitButton.disabled = false;
      submitButton.textContent = 'Create post';
    }
  });
</script>
