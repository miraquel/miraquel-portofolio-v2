---
import Layout from '../../layouts/Layout.astro';
import Strip from '../../components/lading/Strip.astro';
import { findPublishedPostBySlug } from '../../lib/blog';
import { formatDay } from '../../lib/format';
import { sanitizePostContent } from '../../lib/sanitize';
import { postSocialMeta } from '../../lib/social-meta';
import { profile } from '../../data/profile';

export const prerender = false;

const { slug } = Astro.params;

// A missing post answers 404 and a failed read answers 503, instead of quietly redirecting to /blog
const { post, loadFailed } = await findPublishedPostBySlug(slug!).then(
  (post) => ({ post, loadFailed: false }),
  (error) => {
    console.error('Error fetching blog post:', error);
    return { post: null, loadFailed: true };
  }
);

if (!post) {
  Astro.response.status = loadFailed ? 503 : 404;
}

const safeContent = post ? sanitizePostContent(post.content) : '';
const social = post ? postSocialMeta(post, profile.name) : undefined;
const field = 'bg-paper px-4 py-4 sm:px-5';
const label = 'text-[0.8125rem] font-semibold text-form';
const button = 'inline-flex min-h-11 items-center border-2 border-form bg-form px-5 text-sm font-semibold text-paper transition-colors duration-150 hover:border-ink hover:bg-ink';
import '../../styles/post-body.css';
---

<Layout
  title={social?.title ?? (loadFailed ? "Post couldn't load" : 'Post not found')}
  description={post?.excerpt || undefined}
  ogTitle={social?.ogTitle}
  type={social?.type}
  image={social?.image}
  publishedTime={social?.publishedTime}
  author={social?.author}
>
  <Strip />
  <main id="main" class="mx-auto max-w-[85rem] px-4 pb-24 pt-5 sm:px-8 lg:pt-7">
    <div data-band class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-2 border-b-0 border-form bg-form px-4 py-2 text-paper sm:px-5">
      <a href="/blog" class="py-1 font-stencil text-[1.375rem] font-extrabold uppercase leading-none tracking-[0.08em] hover:underline">Notices</a>
      <a href="/blog" class="py-1 text-sm font-semibold underline decoration-paper/50 underline-offset-4 hover:decoration-paper">All posts</a>
    </div>

    {post ? (
      <article>
        <header>
          <div class="border-2 border-b-0 border-form bg-paper px-4 py-6 sm:px-5 sm:py-8">
            <h1 class="max-w-[24ch] text-[clamp(2.25rem,5.5vw,4rem)] font-extrabold leading-[1.05] tracking-[-0.02em]">{post.title}</h1>
            {post.excerpt && <p class="mt-4 max-w-[48ch] text-lg leading-relaxed">{post.excerpt}</p>}
          </div>
          <dl class="grid grid-cols-12 gap-px border-2 border-form bg-form">
            <div class:list={[field, 'col-span-12 sm:col-span-4']}>
              <dt class={label}>Published</dt>
              <dd class="mt-1.5 font-data text-sm font-semibold">{formatDay(post.publishedAt)}</dd>
            </div>
            <div class:list={[field, 'col-span-12 sm:col-span-4']}>
              <dt class={label}>Written by</dt>
              <dd class="mt-1.5 font-extrabold">{post.author}</dd>
            </div>
            <div class:list={[field, 'col-span-12 sm:col-span-4']}>
              <dt class={label}>Tags</dt>
              <dd class="mt-0.5 flex flex-wrap gap-x-4">
                {post.tags.length > 0
                  ? post.tags.map((tag) => (
                      <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="inline-block py-1.5 font-semibold underline decoration-form/40 underline-offset-4 hover:decoration-form">
                        {tag}
                      </a>
                    ))
                  : <span class="py-1.5">None</span>}
              </dd>
            </div>
          </dl>

          {post.imageUrl && (
            <div class="border-2 border-t-0 border-form bg-paper-deep">
              <img src={post.imageUrl} alt="" class="aspect-[21/9] w-full object-cover" />
            </div>
          )}
        </header>

        <div class="post-body mx-auto mt-12 max-w-[42rem] text-[1.125rem] leading-[1.75]" set:html={safeContent} />
      </article>
    ) : (
      <section class="border-2 border-form bg-paper px-4 py-10 sm:px-6">
        <h1 class="text-[clamp(2.25rem,5vw,3.5rem)] font-extrabold leading-tight tracking-[-0.02em]">
          {loadFailed ? "This post couldn't load" : 'Post not found'}
        </h1>
        <p class="mt-3 max-w-[48ch] text-lg leading-relaxed">
          {loadFailed
            ? "The blog's database didn't respond. Reload the page to try again."
            : "This post doesn't exist or is no longer published."}
        </p>
        <a href={loadFailed ? Astro.url.pathname : '/blog'} class:list={[button, 'mt-8']}>
          {loadFailed ? 'Reload' : 'See all posts'}
        </a>
      </section>
    )}
  </main>
</Layout>
