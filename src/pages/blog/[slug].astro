---
import Layout from '../../layouts/Layout.astro';
import { getBlogPostBySlug } from '../../lib/blog';

export const prerender = false;

const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug!);

if (!post) {
  return Astro.redirect('/blog');
}

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  }).format(date);
}
---

<Layout>
  <article class="min-h-screen px-6 max-w-4xl mx-auto py-24">
    <a 
      href="/blog" 
      class="inline-flex items-center gap-2 text-slate-400 hover:text-teal-300 transition-colors duration-200 mb-8"
    >
      <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Back to Blog
    </a>

    <header class="mb-12">
      {post.imageUrl && (
        <div class="w-full aspect-video rounded-lg overflow-hidden border border-slate-400/20 bg-slate-900/50 mb-8">
          <img 
            src={post.imageUrl} 
            alt={post.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}
      
      <h1 class="text-5xl font-bold text-slate-200 leading-tight mb-4">{post.title}</h1>
      
      <div class="flex items-center gap-4 text-slate-400 text-sm mb-6">
        <span>{formatDate(post.publishedAt)}</span>
        <span>·</span>
        <span>{post.author}</span>
      </div>
      
      {post.tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {post.tags.map((tag) => (
            <a
              href={`/blog?tag=${encodeURIComponent(tag)}`}
              class="px-3 pb-1 bg-teal-400/10 hover:bg-teal-400/20 hover:shadow-md rounded-full font-medium transition-all duration-200"
            >
              <span class="text-teal-300 text-sm inline-flex items-center">{tag}</span>
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-invert prose-slate max-w-none">
      <div class="text-slate-300 leading-relaxed space-y-4" set:html={post.content} />
    </div>
  </article>
</Layout>

<style>
  .prose {
    color: #cbd5e1;
  }

  .prose :global(h2) {
    font-size: 2rem;
    font-weight: 700;
    color: #e2e8f0;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .prose :global(h3) {
    font-size: 1.5rem;
    font-weight: 600;
    color: #e2e8f0;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }

  .prose :global(a) {
    color: #5eead4;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .prose :global(a:hover) {
    color: #2dd4bf;
  }

  .prose :global(code) {
    background-color: rgba(30, 41, 59, 0.5);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
    color: #5eead4;
  }

  .prose :global(pre) {
    background-color: rgba(30, 41, 59, 0.5);
    padding: 1.5rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 2rem 0;
  }

  .prose :global(pre code) {
    background-color: transparent;
    padding: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(blockquote) {
    border-left: 4px solid #5eead4;
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #94a3b8;
  }

  .prose :global(img) {
    border-radius: 0.5rem;
    margin: 2rem 0;
  }
</style>
