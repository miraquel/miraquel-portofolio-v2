---
import Layout from '../../layouts/Layout.astro';
import { getAllBlogPosts } from '../../lib/blog';

const allPosts = await getAllBlogPosts();

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  }).format(date);
}
---

<Layout>
  <div class="min-h-screen px-6 max-w-5xl mx-auto py-24">
    <div class="mb-12">
      <a 
        href="/" 
        class="inline-flex items-center gap-2 text-slate-400 hover:text-teal-300 transition-colors duration-200 mb-8"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Home
      </a>
      
      <h1 class="text-5xl font-bold text-slate-200 leading-tight mb-4">Blog</h1>
      <p class="text-slate-400 text-lg">Thoughts, tutorials, and insights about software development</p>
    </div>

    <div class="flex flex-col gap-6">
      {allPosts.length > 0 ? (
        allPosts.map((post) => (
          <article class="group">
            <a 
              href={`/blog/${post.slug}`}
              class="grid grid-cols-1 md:grid-cols-[200px_1fr] gap-6 p-6 rounded-lg transition-all duration-300 hover:bg-slate-800/50 hover:shadow-[0_0_0_1px_rgba(148,163,184,0.1)]"
            >
              {post.imageUrl ? (
                <div class="w-full aspect-video rounded overflow-hidden border border-slate-400/20 bg-slate-900/50">
                  <img 
                    src={post.imageUrl} 
                    alt={post.title}
                    class="w-full h-full object-cover"
                  />
                </div>
              ) : (
                <div class="w-full aspect-video rounded overflow-hidden border border-slate-400/20 bg-gradient-to-br from-slate-800/80 to-slate-700/80 flex items-center justify-center text-slate-600">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                  </svg>
                </div>
              )}
              
              <div class="flex flex-col gap-3">
                <h2 class="text-xl font-semibold text-slate-200 m-0 group-hover:text-teal-300 transition-colors duration-200">
                  {post.title}
                </h2>
                <p class="text-slate-400 text-sm">
                  {formatDate(post.publishedAt)} · {post.author}
                </p>
                <p class="text-slate-400 leading-relaxed">
                  {post.excerpt}
                </p>
                {post.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-2">
                    {post.tags.map((tag) => (
                      <span class="inline-block px-3 py-1 bg-teal-400/10 text-teal-300 rounded-full text-xs font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          </article>
        ))
      ) : (
        <div class="text-center py-16">
          <p class="text-slate-400 text-lg">No blog posts available yet.</p>
          <p class="text-slate-500 text-sm mt-2">Check back soon for new content!</p>
        </div>
      )}
    </div>
  </div>
</Layout>
