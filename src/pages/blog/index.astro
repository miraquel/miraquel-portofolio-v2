---
import Layout from '../../layouts/Layout.astro';
import { getAllBlogPosts, getBlogPostsByTag, getTagCounts } from '../../lib/blog';

export const prerender = false;

const selectedTag = Astro.url.searchParams.get('tag');
const allPosts = selectedTag ? await getBlogPostsByTag(selectedTag) : await getAllBlogPosts();
const tagCounts = await getTagCounts();
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  }).format(date);
}
---

<Layout>
  <div class="min-h-screen px-6 max-w-5xl mx-auto py-24">
    <a 
      href="/" 
      class="inline-flex items-center gap-2 text-slate-400 hover:text-teal-300 transition-colors duration-200 mb-8 block"
    >
      <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Back to Home
    </a>
    
    <div class="mb-8">
      <h1 class="text-5xl font-bold text-slate-200 leading-tight mb-4">Blog</h1>
      <p class="text-slate-400 text-lg">Thoughts, tutorials, and insights about software development</p>
    </div>

    {sortedTags.length > 0 && (
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-3">
          <h2 class="text-sm font-semibold text-slate-200 uppercase tracking-wider">Filter by tag:</h2>
          {selectedTag && (
            <a 
              href="/blog" 
              class="inline-flex items-center gap-1 px-3 py-1 bg-slate-700 hover:bg-slate-600 text-slate-300 rounded-full text-xs transition-colors"
            >
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
              Clear filter
            </a>
          )}
        </div>
        <div class="flex flex-wrap gap-2">
          {sortedTags.map(([tag, count]) => (
            <a 
              href={`/blog?tag=${encodeURIComponent(tag)}`}
              class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-200 ${
                selectedTag === tag 
                  ? 'bg-teal-500 text-slate-900 shadow-lg shadow-teal-500/20' 
                  : 'bg-teal-400/10 text-teal-300 hover:bg-teal-400/20 hover:shadow-md'
              }`}
            >
              <span class="text-slate-200 text-xs">
                {tag}
              </span>
              <span class={`text-[10px] ${
                selectedTag === tag ? 'text-slate-700' : 'text-teal-400'
              }`}>({count})</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {selectedTag && (
      <div class="mb-6 p-3 bg-teal-400/10 border border-teal-400/20 rounded-lg">
        <p class="text-teal-300 text-xs">
          Showing <span class="font-semibold">{allPosts.length}</span> post{allPosts.length !== 1 ? 's' : ''} tagged with <span class="font-semibold">"{selectedTag}"</span>
        </p>
      </div>
    )}

    <div class="flex flex-col gap-6">
      {allPosts.length > 0 ? (
        allPosts.map((post) => (
          <article class="group">
            <div class="grid grid-cols-1 md:grid-cols-[200px_1fr] gap-6 p-6 rounded-lg transition-all duration-300 hover:bg-slate-800/50 hover:shadow-[0_0_0_1px_rgba(148,163,184,0.1)]">
              <a href={`/blog/${post.slug}`} class="block">
                {post.imageUrl ? (
                  <div class="w-full md:w-[200px] aspect-video md:aspect-[4/3] rounded overflow-hidden border border-slate-400/20 bg-slate-900/50 flex-shrink-0">
                    <img 
                      src={post.imageUrl} 
                      alt={post.title}
                      class="w-full h-full object-cover"
                    />
                  </div>
                ) : (
                  <div class="w-full md:w-[200px] aspect-video md:aspect-[4/3] rounded overflow-hidden border border-slate-400/20 bg-gradient-to-br from-slate-800/80 to-slate-700/80 flex items-center justify-center text-slate-600 flex-shrink-0">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                      <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                  </div>
                )}
              </a>
              
              <div class="flex flex-col gap-3">
                <a href={`/blog/${post.slug}`}>
                  <h2 class="text-xl font-semibold text-slate-200 m-0 group-hover:text-teal-300 transition-colors duration-200">
                    {post.title}
                  </h2>
                </a>
                <p class="text-slate-400 text-sm">
                  {formatDate(post.publishedAt)} · {post.author}
                </p>
                <a href={`/blog/${post.slug}`}>
                  <p class="text-slate-400 leading-relaxed">
                    {post.excerpt}
                  </p>
                </a>
                {post.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-2">
                    {post.tags.map((tag) => (
                      <a
                        href={`/blog?tag=${encodeURIComponent(tag)}`}
                        class="px-3 pb-1 bg-teal-400/10 hover:bg-teal-400/20 hover:shadow-md rounded-full font-medium transition-all duration-200"
                      >
                        <span class="text-teal-300 text-xs">{tag}</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        ))
      ) : (
        <div class="text-center py-16">
          <p class="text-slate-400 text-lg">No blog posts available yet.</p>
          <p class="text-slate-500 text-sm mt-2">Check back soon for new content!</p>
        </div>
      )}
    </div>
  </div>
</Layout>
