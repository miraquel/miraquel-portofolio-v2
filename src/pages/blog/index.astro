---
import Layout from '../../layouts/Layout.astro';
import Strip from '../../components/lading/Strip.astro';
import { countTags, getPublishedPosts, type BlogPost } from '../../lib/blog';
import { formatDay } from '../../lib/format';

export const prerender = false;

const selectedTag = Astro.url.searchParams.get('tag');

// One read serves both the list and the tag counts; a failed read must not look like an empty blog
let publishedPosts: BlogPost[] = [];
let loadFailed = false;
try {
  publishedPosts = await getPublishedPosts();
} catch (error) {
  console.error('Error fetching blog posts:', error);
  loadFailed = true;
  Astro.response.status = 503;
}

const allPosts = selectedTag ? publishedPosts.filter(post => post.tags.includes(selectedTag)) : publishedPosts;
const sortedTags = Object.entries(countTags(publishedPosts)).sort((a, b) => b[1] - a[1]);

const button = 'inline-flex min-h-11 items-center border-2 border-form bg-form px-5 text-sm font-semibold text-paper transition-colors duration-150 hover:border-ink hover:bg-ink';
---

<Layout title="Blog: Chaidir Ali Assegaf" description="Notes on software development, the Microsoft Dynamics ecosystem and web technologies.">
  <Strip />
  <main id="main" class="mx-auto max-w-[85rem] px-4 pb-24 pt-5 sm:px-8 lg:pt-7">
    <div data-band class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-2 border-b-0 border-form bg-form px-4 py-2 text-paper sm:px-5">
      <p class="font-stencil text-[1.375rem] font-extrabold uppercase leading-none tracking-[0.08em]">Notices</p>
      <p class="font-data text-xs">{loadFailed ? 'Not loaded' : `${publishedPosts.length} published`}</p>
    </div>
    <div class="border-2 border-form px-4 py-6 sm:px-6 sm:py-8">
      <h1 class="text-[clamp(2.5rem,6vw,4rem)] font-extrabold leading-none tracking-[-0.02em]">Blog</h1>
      <p class="mt-4 max-w-[48ch] text-lg leading-relaxed">
        Notes on software development, the Microsoft Dynamics ecosystem and web technologies.
      </p>

      {sortedTags.length > 0 && (
        <div class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h2 class="text-[0.8125rem] font-semibold text-form">Filter by tag</h2>
          <ul class="flex flex-wrap gap-2">
            {sortedTags.map(([tag, count]) => (
              <li>
                <a
                  href={`/blog?tag=${encodeURIComponent(tag)}`}
                  aria-current={selectedTag === tag ? 'page' : undefined}
                  class:list={[
                    'inline-flex min-h-11 items-center gap-2 border-2 border-form px-3 text-sm font-semibold transition-colors duration-150',
                    selectedTag === tag ? 'bg-form text-paper' : 'bg-paper text-form hover:bg-paper-deep',
                  ]}
                >
                  {tag}
                  <span class="font-data text-xs font-medium">{count}</span>
                </a>
              </li>
            ))}
          </ul>
          {selectedTag && (
            <a href="/blog" class="inline-block px-1 py-3 text-sm font-semibold underline decoration-form/40 underline-offset-4 hover:decoration-form">
              Clear filter
            </a>
          )}
        </div>
      )}
    </div>

    {allPosts.length > 0 ? (
      <section aria-labelledby="posts-title" class="mt-10">
        <h2 id="posts-title" class="text-[0.8125rem] font-semibold text-form">
          {selectedTag
            ? `${allPosts.length} ${allPosts.length === 1 ? 'post' : 'posts'} tagged "${selectedTag}"`
            : 'All posts, newest first'}
        </h2>
        <ol class="mt-3 grid gap-px border-2 border-form bg-form">
          {allPosts.map((post, index) => (
            <li class="grid gap-x-8 gap-y-2 bg-paper px-4 py-6 sm:grid-cols-[3rem_11rem_minmax(0,1fr)] sm:px-6">
              <span class="font-data text-sm text-form">{String(index + 1).padStart(2, '0')}</span>
              <span class="font-data text-[0.8125rem] sm:pt-1">{formatDay(post.publishedAt)}</span>
              <div>
                <h3 class="text-[1.375rem] font-extrabold leading-snug">
                  <a href={`/blog/${post.slug}`} class="underline decoration-form/40 decoration-2 underline-offset-4 hover:decoration-form">
                    {post.title}
                  </a>
                </h3>
                {post.excerpt && <p class="mt-2 max-w-[44ch] leading-relaxed text-ink/85">{post.excerpt}</p>}
                <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
                  <span class="text-form">{post.author}</span>
                  {post.tags.map((tag) => (
                    <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="inline-block py-2 font-semibold underline decoration-form/40 underline-offset-4 hover:decoration-form">
                      {tag}
                    </a>
                  ))}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ) : (
      <section class="mt-10 border-2 border-form bg-paper px-4 py-10 sm:px-6">
        {loadFailed ? (
          <>
            <h2 class="text-2xl font-extrabold">Posts couldn't load</h2>
            <p class="mt-2 max-w-[48ch] leading-relaxed">The blog's database didn't respond. Reload the page to try again.</p>
            <a href={`${Astro.url.pathname}${Astro.url.search}`} class:list={[button, 'mt-6']}>Reload</a>
          </>
        ) : selectedTag ? (
          <>
            <h2 class="text-2xl font-extrabold">No posts are tagged "{selectedTag}"</h2>
            <a href="/blog" class:list={[button, 'mt-6']}>Show all posts</a>
          </>
        ) : (
          <>
            <h2 class="text-2xl font-extrabold">No posts yet</h2>
            <p class="mt-2 max-w-[48ch] leading-relaxed">Nothing has been published here yet.</p>
          </>
        )}
      </section>
    )}
  </main>
</Layout>
