---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import Bill from '../components/lading/Bill.astro';
import ContainerBay from '../components/lading/ContainerBay.astro';
import Credentials from '../components/lading/Credentials.astro';
import Employers from '../components/lading/Employers.astro';
import Manifest from '../components/lading/Manifest.astro';
import SectionHead from '../components/lading/SectionHead.astro';
import Strip from '../components/lading/Strip.astro';
import { containers } from '../data/work';
---

<Layout>
	<Strip onHome />
	<main id="main">
		<Bill />

		<section id="containers" aria-labelledby="containers-title" class="scroll-mt-14">
			<div class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-8">
				<SectionHead
					n={10}
					id="containers-title"
					title="Case studies"
					note="Four projects, carried as containers. Each opens onto the route its data travels, drawn from the systems as built. A mark's serial is the month the project started."
				/>
			</div>
			{containers.map((container) => <ContainerBay container={container} />)}
		</section>

		<Manifest />
		<Employers />
		<Credentials />
	</main>
	<Contact />
</Layout>

<script>
	// A Marks and numbers card and the Description of goods lines it carries light together: a card
	// shows what the project used, and a line shows the projects that prove it. They sit next to
	// each other, so both ends are in view. Touch is left out, where a tap would only flash them.
	const cards = [...document.querySelectorAll<HTMLElement>('[data-carries]')];
	const lines = [...document.querySelectorAll<HTMLElement>('[data-goods-line]')];
	const carries = (card: HTMLElement, line: HTMLElement) =>
		(card.dataset.carries ?? '').split(' ').includes(line.dataset.goodsLine ?? '');
	const pair = (el: HTMLElement, partners: HTMLElement[]) => {
		if (!partners.length) return;
		const light = (on: boolean) => [el, ...partners].forEach((item) => item.classList.toggle('is-crossed', on));
		el.addEventListener('pointerenter', (event) => event.pointerType !== 'touch' && light(true));
		el.addEventListener('pointerleave', () => light(false));
		el.addEventListener('focusin', () => light(true));
		el.addEventListener('focusout', () => light(false));
	};
	cards.forEach((card) => pair(card, lines.filter((line) => carries(card, line))));
	lines.forEach((line) => pair(line, cards.filter((card) => carries(card, line))));

	// Following a container link shuts that bay's doors while its route is off screen, then swings
	// them open once the route comes into view: at once on a desktop, where the route sits beside
	// the heading, and when a phone reader scrolls down to it. The doors only ever cover the route,
	// so while they are shut nothing in view is hidden. At rest they stand open.
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
		document.querySelectorAll<HTMLAnchorElement>('a[data-container-link]').forEach((link) => {
			link.addEventListener('click', () => {
				const bay = document.getElementById(link.dataset.containerLink ?? '');
				const hold = bay?.querySelector('.bay-hold');
				if (!bay || !hold) return;
				bay.classList.add('is-shut');

				const open = () => {
					observer.disconnect();
					requestAnimationFrame(() => requestAnimationFrame(() => bay.classList.remove('is-shut')));
				};
				const observer = new IntersectionObserver(
					(entries) => {
						if (entries.some((entry) => entry.isIntersecting)) setTimeout(open, 120);
					},
					{ threshold: 0.35 }
				);
				observer.observe(hold);
			});
		});
	}
</script>
